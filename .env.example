# Copy this file to .env and fill it in. Never commit .env or the certs/ folder.
# Leaving a value blank uses the local Docker services from docker-compose.yml.

PORT=4000
# Any long random string. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Freeze rules
FREEZE_MINUTES=30
MAX_ACTIVE_FREEZES=3
MAX_QTY_PER_ITEM=5

# ---------- Aiven for PostgreSQL ----------
# Service page > Overview > "Service URI" (postgres://avnadmin:...@host:port/defaultdb?sslmode=require)
DATABASE_URL=
# Download "CA certificate" from the same page and save it as certs/pg-ca.pem
PG_CA_CERT=

# ---------- Aiven for Apache Kafka ----------
# Service page > Overview > "Service URI" (host:port)
KAFKA_BROKERS=
# Authentication "Client certificate": download the three files into certs/
KAFKA_CA_CERT=
KAFKA_ACCESS_CERT=
KAFKA_ACCESS_KEY=
# Or, if you enabled SASL instead, fill these and leave the cert/key empty (CA is still needed)
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ---------- Aiven for OpenSearch ----------
# Service page > Overview > "Service URI" (https://avnadmin:...@host:port)
OPENSEARCH_URL=
OPENSEARCH_INDEX=dailycart-products

# ---------- AI help chatbot (Groq, free tier) ----------
# Create a key at console.groq.com > API Keys. Leave blank to turn the chatbot off.
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
# Shopkeeper voice stock updates use the same key. Speech-to-text model
# (optional; whisper-large-v3-turbo is faster but less accurate on Hinglish).
STT_MODEL=whisper-large-v3

# ---------- Sign in with Google (optional) ----------
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID > Web application.
# Add your site under "Authorized JavaScript origins" (e.g. http://localhost:5173 and your Vercel URL).
# Only the client ID is needed (no secret). Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=
